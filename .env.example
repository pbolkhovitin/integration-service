# PostgreSQL (required: set POSTGRES_PASSWORD in your .env)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=integration
POSTGRES_USER=integration

# Redis
REDIS_URL=redis://redis:6379/0

# FastAPI
APP_HOST=0.0.0.0
APP_PORT=8000

# GLPI
GLPI_URL=http://glpi:80
# GLPI (App-Token auth --- Phase 1 MVP)
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=

# GLPI (OAuth2 --- Phase 4 upgrade)
GLPI_CLIENT_ID=
GLPI_CLIENT_SECRET=
GLPI_USERNAME=
GLPI_PASSWORD=

# Bitrix24
BITRIX24_WEBHOOK_URL=

# Bitrix24 defaults
BITRIX24_USER_ID=

# Employee mapping
EMPLOYEE_MAPPING_PATH=/app/config/employee_mapping.json

# Whisper (faster-whisper)
WHISPER_MODEL_SIZE=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BATCH_SIZE=8

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Retry
RETRY_BACKOFF_BASE=2
RETRY_BACKOFF_MAX=300
