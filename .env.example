# ─── PostgreSQL ────────────────────────────────────────────
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=integration
POSTGRES_USER=integration
POSTGRES_PASSWORD=changeme

# ─── FastAPI ──────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS: разрешённые origin через запятую (пусто = CORS отключен)
CORS_ORIGINS=

# Общий секрет для мутирующих эндпоинтов /api/bitrix24/sync/*
# (trigger, cleanup, retry, reverse-test). Передаётся в заголовке X-Admin-Token.
# Пусто = эндпоинты закрыты (401).
ADMIN_API_TOKEN=

# ─── GLPI (App-Token auth — MVP) ──────────────────────────
GLPI_URL=http://glpi-app:80
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=

# GLPI ticket defaults
GLPI_DEFAULT_CATEGORY_ID=1    # 1=Инцидент, 8=Запрос
GLPI_DEFAULT_GROUP_ID=1       # 1=IT-поддержка L1
GLPI_DEFAULT_ENTITY_ID=2      # 2=Департамент IT

# ─── GLPI (OAuth2 — Phase 4, не используется в MVP) ──────
GLPI_CLIENT_ID=
GLPI_CLIENT_SECRET=
GLPI_USERNAME=
GLPI_PASSWORD=

# ─── Bitrix24 (polling mode — MVP) ───────────────────────
# Webhook URL: https://b24.example.com/rest/{USER_ID}/{TOKEN}
BITRIX24_WEBHOOK_URL=
BITRIX24_RESPONSIBLE_IDS=70   # comma-separated user IDs, e.g. "70,71,72"
BITRIX24_POLL_INTERVAL_SECONDS=60
# Интервал обратной синхронизации (GLPI → Bitrix24) для whitelist-задач
BITRIX24_REVERSE_SYNC_INTERVAL_SECONDS=60
# Автозапись в Bitrix24 (reverse sync). Разрешена ТОЛЬКО для задач из
# TEST_TASK_IDS (whitelist-проверка в коде). true = поллер сам синхронизирует
# тестовые задачи; false = только вручную через POST /sync/reverse-test.
BITRIX24_REVERSE_SYNC_ENABLED=true

# ─── Org sync (пользователи и отделы Bitrix24 → GLPI) ───────────────
# Вебхук С ПРАВАМИ user + department (обычный BITRIX24_WEBHOOK_URL их не имеет).
# Пусто = org sync выключен.
#BITRIX24_ORG_WEBHOOK_URL=
# Автозапуск org sync по расписанию (ручной POST /api/bitrix24/sync/org работает всегда)
ORG_SYNC_ENABLED=false
ORG_SYNC_INTERVAL_SECONDS=3600
# Корневая GLPI-entity, под которую зеркалится дерево отделов Bitrix24
ORG_SYNC_ROOT_ENTITY_ID=25
# GLPI-профиль для синхронизируемых пользователей (1 = Self-Service)
ORG_SYNC_USER_PROFILE_ID=1

# Bitrix24 (Production — Phase 2+)
BITRIX24_USER_ID=

# ─── Redis (Production — Phase 2+) ───────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Celery (Production — Phase 2+) ──────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ─── Employee Mapping (Production — Phase 2+) ────────────
EMPLOYEE_MAPPING_PATH=/app/config/employee_mapping.json

# ─── Whisper — faster-whisper (Production — Phase 3+) ────
WHISPER_MODEL_SIZE=large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BATCH_SIZE=8

# ─── Retry (Production — Phase 2+) ──────────────────────
RETRY_BACKOFF_BASE=2
RETRY_BACKOFF_MAX=300
